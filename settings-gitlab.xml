<?xml version="1.0" encoding="UTF-8"?>
<!--
    Maven settings used only by the Jenkinsfile's "Publish to GitLab" stage.
    Credentials are pulled from environment variables that Jenkins sets via
    a bound credential (id: gitlab-deploy-token) — nothing secret lives in
    this file, so it's safe to commit.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>gitlab-maven</id>
            <username>${env.GITLAB_DEPLOY_USERNAME}</username>
            <password>${env.GITLAB_DEPLOY_PASSWORD}</password>
        </server>
    </servers>
</settings>
